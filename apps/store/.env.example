# Loopback: o Server Component fala com a API sem TLS, sem DNS, sem sair da máquina.
INTERNAL_API_URL=http://127.0.0.1:4000

# O browser precisa do domínio público — 127.0.0.1 seria a máquina do cliente.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Host de onde vêm as imagens, para o next/image (remotePatterns). Com
# STORAGE_DRIVER=s3 é o endpoint do bucket. Em dev fica vazio: a API serve /uploads.
# ATENÇÃO: NEXT_PUBLIC_* é inlined no BUILD — mudar aqui exige rebuild, não restart.
# NEXT_PUBLIC_CDN_HOST=artenojardimbucket.s3.us-east-1.amazonaws.com

# Segredo que a API manda para POST /api/revalidate (descarta o cache ISR quando
# o lojista mexe num produto). Mesmo valor do STORE_REVALIDATE_SECRET da API.
# Vazio = a rota recusa tudo e o catálogo atualiza só pelo TTL de 60s.
REVALIDATE_SECRET=
