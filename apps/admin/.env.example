# O admin fala com a API só do browser — toda tela é autenticada e por usuário,
# então não há INTERNAL_API_URL aqui.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Host de onde vêm as imagens, para o next/image (remotePatterns). Com
# STORAGE_DRIVER=s3 é o endpoint do bucket. Em dev fica vazio: a API serve /uploads.
# ATENÇÃO: NEXT_PUBLIC_* é inlined no BUILD — mudar aqui exige rebuild, não restart.
# NEXT_PUBLIC_CDN_HOST=artenojardimbucket.s3.us-east-1.amazonaws.com
