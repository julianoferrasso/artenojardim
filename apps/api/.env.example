# Copie para .env e preencha. A API RECUSA subir se faltar qualquer variável
# obrigatória — é intencional: melhor falhar no boot que às 3h da manhã com undefined.

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# ── Banco ────────────────────────────────────────────────────────────────────
# O Postgres vive na VPS e NÃO é exposto na internet (a 5432 está fechada no UFW
# e o pg_hba só aceita loopback). O acesso é por túnel SSH:
#
#     .\scripts\db-tunnel.ps1      ← deixe rodando antes de `pnpm dev`
#
# 5433 local para não colidir com um Postgres instalado na máquina, e para não
# haver dúvida sobre em qual banco você está mexendo.
#
# A senha vai URL-encoded: o "@" separa userinfo de host numa URL, então sem
# %40 o parser lê o resto da senha como hostname.
DATABASE_URL=postgresql://artenojardim:%40SENHA%21@127.0.0.1:5433/artenojardim?schema=public&connection_limit=5

# Banco descartável do `migrate dev` (só desenvolvimento). Pré-criado e de posse
# do role, para não precisar dar CREATEDB à aplicação num servidor compartilhado.
SHADOW_DATABASE_URL=postgresql://artenojardim:%40SENHA%21@127.0.0.1:5433/artenojardim_shadow?schema=public

# ── Loja única ───────────────────────────────────────────────────────────────
# Preenchido pelo `pnpm db:seed`, que imprime o id gerado.
# Na Fase 4 esta variável some: o tenant passa a ser resolvido pelo Host.
STORE_ID=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Segredos DISTINTOS e fortes. Gere com: openssl rand -base64 48
# Staff e cliente têm segredos diferentes: vazar um não vaza o outro.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_CUSTOMER_ACCESS_SECRET=
JWT_CUSTOMER_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowlist explícita. Nunca "*" com credentials.
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ── Storage ──────────────────────────────────────────────────────────────────
# local = disco em ./uploads, sem credencial nenhuma (desenvolvimento)
# s3    = AWS S3, bucket público para leitura (produção — o que rodamos hoje)
# r2    = Cloudflare R2 (alternativa: não cobra egress; ver docs/arquitetura.md §13)
#
# As credenciais do driver escolhido são OBRIGATÓRIAS — o boot morre sem elas.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# Obrigatórias quando STORAGE_DRIVER=s3.
# Usuário IAM PRÓPRIO, separado do usuário do SES abaixo: permissões disjuntas
# (PutObject/GetObject/DeleteObject em <bucket>/store/* e ListBucket no bucket),
# e vazar uma credencial não compromete a outra.
# O ListBucket não é opcional: sem ele o S3 responde 403 em vez de 404 numa key
# inexistente, e o confirm de upload devolveria 502 no lugar do 422 correto.
# S3_REGION é a region DO BUCKET — não necessariamente a mesma AWS_REGION do SES.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Opcional. Vazio = a URL pública é https://<bucket>.s3.<region>.amazonaws.com.
# Preencher só quando entrar CloudFront ou domínio próprio (cdn.artenojardim.com.br).
S3_PUBLIC_URL=

# Obrigatórias quando STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Pagamentos (Stripe) ──────────────────────────────────────────────────────
# STRIPE_PUBLIC (publishable) e STRIPE_SECRET vêm do dashboard do Stripe.
# STRIPE_WEBHOOK_SECRET só existe depois de registrar o endpoint:
#   dev  → `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`
#   prod → dashboard, endpoint https://api.artenojardim.com.br/api/v1/webhooks/stripe
STRIPE_PUBLIC=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── E-mail transacional (AWS SES) ────────────────────────────────────────────
# Domínio artenojardim.com.br verificado no SES; usuário IAM com acesso ao SES.
#
# As três (chave, segredo e remetente) andam JUNTAS: metade configurada derruba
# o boot de propósito — o contrário passaria no boot e falharia no primeiro
# cadastro. Em produção são OBRIGATÓRIAS: com a confirmação de e-mail bloqueando
# o login, sem envio ninguém cria conta nem recupera senha.
#
# ATENÇÃO — SANDBOX: conta SES nova só envia para endereços verificados um a um,
# 200/dia. Antes de subir, peça "Production access" no console da AWS, senão
# nenhum cliente novo consegue entrar. Publique também os 3 CNAMEs de Easy DKIM:
# domínio verificado SEM DKIM vai direto para o spam, sem erro nenhum do SES.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@artenojardim.com.br
EMAIL_FROM_NAME=Arte no Jardim
# Opcional: para onde vai quem responder ao "noreply". Vazio = sem cabeçalho
# Reply-To (a resposta do cliente se perde, que é a decisão atual).
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ── Fila (RabbitMQ) ──────────────────────────────────────────────────────────
# Confirmação de pedido e campanhas de marketing passam por aqui. Sem ela a API
# sobe normalmente e publicar responde 503 — a loja continua vendendo, só o
# e-mail espera. OBRIGATÓRIA em produção.
#
# Use um vhost PRÓPRIO: a VPS é compartilhada, e dev apontado para o broker de
# produção consumiria mensagens reais. Dev: .../artenojardim_dev
# RABBITMQ_URL=amqp://artenojardim:senha@127.0.0.1:5672/artenojardim
#
# Mensagens que um consumidor pega antes do ack. 1 é a regra da arquitetura §12:
# acumular trabalho não processado num worker que pode morrer é perda, não vazão.
# RABBITMQ_PREFETCH=1
#
# Vazão do envio. O SES entrega ~14/s; 10 deixa folga para o transacional não
# ficar preso atrás de uma campanha.
# EMAIL_SEND_RATE_PER_SECOND=10

# Assina o link de descadastro do rodapé. Segredo PRÓPRIO, nunca um dos JWT_*:
# girar um segredo de sessão invalidaria todo link já entregue, e um e-mail de
# dois anos atrás precisa continuar descadastrando. Obrigatório em produção.
#   openssl rand -base64 48
# EMAIL_UNSUBSCRIBE_SECRET=

# ── Integrações (Fase 1 — ainda não usadas) ──────────────────────────────────
# MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_SANDBOX=true
